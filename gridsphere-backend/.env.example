# ---------------------------------------------------
# Database (Neon - serverless PostgreSQL)
# ---------------------------------------------------
# 1. Create a project at https://console.neon.tech
# 2. In the Neon dashboard, grab both connection strings:
#      - "Pooled connection"  -> DATABASE_URL   (used by the running app)
#      - "Direct connection"  -> DIRECT_URL     (used by `prisma migrate`)
#    (If your Neon project only shows one string, use it for both.)
# 3. Keep `sslmode=require` - Neon requires TLS.
DATABASE_URL="postgresql://<user>:<password>@<endpoint>-pooler.<region>.aws.neon.tech/<dbname>?sslmode=require"
DIRECT_URL="postgresql://<user>:<password>@<endpoint>.<region>.aws.neon.tech/<dbname>?sslmode=require"

# ---------------------------------------------------
# Auth / JWT (matches original hardcoded values from dependencies.py / jwt_handler.py)
# ---------------------------------------------------
JWT_SECRET="gridsphere_super_secret_key_change_in_production"
JWT_ALGORITHM="HS256"
JWT_EXPIRES_IN_MINUTES=10080

# ---------------------------------------------------
# Server
# ---------------------------------------------------
PORT=8000
NODE_ENV=development

# ---------------------------------------------------
# AI Advisory (DeepSeek)
# ---------------------------------------------------
# Get a key at https://platform.deepseek.com - the advisory endpoint
# (GET /devices/:id/advisory) returns 503 with a clear message if this is
# left blank, rather than failing silently.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat


# Admin user for seeding
ADMIN_EMAIL=admin@gridsphere.com
ADMIN_PASSWORD=admin123  # Change this in production!
